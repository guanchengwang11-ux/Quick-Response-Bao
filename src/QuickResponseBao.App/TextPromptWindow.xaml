<Window x:Class="QuickResponseBao.App.TextPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Categories}" Width="440" Height="180" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PromptText"/><TextBox x:Name="ValueText" Grid.Row="1" MaxLength="100"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Save}" Click="Save_Click" IsDefault="True"/><Button Content="{DynamicResource Cancel}" IsCancel="True"/></StackPanel></Grid>
</Window>
