<ui:FluentWindow x:Class="QuickResponseBao.App.ResponseEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource AddResponseTitle}" Width="800" Height="760" MinWidth="660" MinHeight="620"
                 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="/assets/branding/QuickResponseBao.ico"
                 WindowBackdropType="None" ExtendsContentIntoTitleBar="False" Background="{DynamicResource QrbBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <Grid Margin="32,24,32,28" MaxWidth="760" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
          <TextBlock x:Name="EditorHeading" Text="{DynamicResource AddResponseTitle}" Style="{DynamicResource QrbPageTitleTextStyle}"/>
          <TextBlock Text="{DynamicResource ResponseEditorDescription}" Style="{DynamicResource QrbBodyTextStyle}" Foreground="{DynamicResource QrbTextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
          <DockPanel Margin="0,0,0,7"><TextBlock Text="{DynamicResource Summary}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock x:Name="SummaryCounter" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{DynamicResource QrbCaptionTextStyle}"/></DockPanel>
          <TextBox x:Name="SummaryText" MaxLength="150" Style="{DynamicResource QrbTextBoxStyle}" TextChanged="SummaryText_TextChanged"/>
          <TextBlock x:Name="SummaryError" Text="{DynamicResource ValidationSummary}" Foreground="{DynamicResource QrbErrorBrush}" Margin="4,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
          <DockPanel Margin="0,0,0,7"><TextBlock Text="{DynamicResource Content}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource ContentLimitHint}" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{DynamicResource QrbCaptionTextStyle}"/></DockPanel>
          <TextBox x:Name="ContentText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="240" MaxHeight="360" Padding="12" TextChanged="ContentText_TextChanged"/>
          <DockPanel Margin="4,5,0,0"><TextBlock x:Name="ContentError" Text="{DynamicResource ValidationContent}" Foreground="{DynamicResource QrbErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="480"/><TextBlock x:Name="ContentCounter" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource QrbTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Right" Style="{DynamicResource QrbCaptionTextStyle}"/></DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
          <TextBlock Text="{DynamicResource Keywords}" Style="{DynamicResource QrbBodyStrongTextStyle}" Margin="0,0,0,7"/>
          <Border Background="{DynamicResource QrbSurfaceBrush}" BorderBrush="{DynamicResource QrbBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
            <WrapPanel>
              <ItemsControl x:Name="KeywordItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{DynamicResource QrbStatusBadgeStyle}" Margin="0,3,6,3" Padding="9,4"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Button Style="{DynamicResource QrbIconButtonStyle}" Width="24" MinWidth="24" Height="24" MinHeight="24" Padding="2" Margin="5,0,-4,0" Click="RemoveKeyword_Click" ToolTip="{DynamicResource RemoveKeyword}"><ui:SymbolIcon Symbol="Dismiss24" Width="14" Height="14"/></Button></StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Grid Width="220" Margin="0,3,0,3"><TextBox x:Name="KeywordInput" BorderThickness="0" Background="Transparent" Padding="5,4" MinHeight="30" KeyDown="KeywordInput_KeyDown" TextChanged="KeywordInput_TextChanged"/><TextBlock Text="{DynamicResource AddKeyword}" Foreground="{DynamicResource QrbTextSecondaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=KeywordInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            </WrapPanel>
          </Border>
          <TextBlock Text="{DynamicResource KeywordEntryHint}" Style="{DynamicResource QrbCaptionTextStyle}" Margin="4,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{DynamicResource Category}" Style="{DynamicResource QrbBodyStrongTextStyle}" Margin="0,0,0,7"/><ComboBox x:Name="CategoryBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Language}" Style="{DynamicResource QrbBodyStrongTextStyle}" Margin="0,0,0,7"/><ComboBox x:Name="LanguageBox" SelectedIndex="0"><ComboBoxItem Tag="English" Content="{DynamicResource EnglishLanguage}"/><ComboBoxItem Tag="简体中文" Content="{DynamicResource ChineseLanguage}"/></ComboBox></StackPanel>
        </Grid>

        <Border Grid.Row="5" Style="{DynamicResource QrbCardStyle}" Margin="0" Padding="16,12">
          <DockPanel LastChildFill="True"><ui:ToggleSwitch x:Name="EnabledBox" DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{DynamicResource QrbToggleSwitchStyle}"/><StackPanel><TextBlock Text="{DynamicResource Enabled}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource EnabledResponseHint}" Style="{DynamicResource QrbCaptionTextStyle}" Margin="0,3,12,0"/></StackPanel></DockPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource QrbSurfaceBrush}" BorderBrush="{DynamicResource QrbBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource Cancel}" Style="{DynamicResource QrbGhostButtonStyle}" IsCancel="True"/>
        <Button x:Name="SaveButton" Content="{DynamicResource SaveResponse}" Style="{DynamicResource QrbPrimaryButtonStyle}" Click="Save_Click" IsDefault="True" MinWidth="140"/>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
