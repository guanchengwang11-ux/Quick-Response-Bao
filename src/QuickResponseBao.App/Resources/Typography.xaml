<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="QrbFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>

  <Style x:Key="QrbDisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="42" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" />
  </Style>
  <Style x:Key="QrbPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QrbDisplayTextStyle}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LineHeight" Value="36" />
  </Style>
  <Style x:Key="QrbSectionTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" />
  </Style>
  <Style x:Key="QrbBodyStrongTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" />
  </Style>
  <Style x:Key="QrbBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="QrbCaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
