<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="PrimaryColor">#2563EB</Color>
  <Color x:Key="AccentColor">#DC2626</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="CanvasColor">#F5F7FB</Color>
  <Color x:Key="TextColor">#172033</Color>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="4" />
    <Setter Property="MinWidth" Value="80" /><Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="4" />
  </Style>
</ResourceDictionary>
