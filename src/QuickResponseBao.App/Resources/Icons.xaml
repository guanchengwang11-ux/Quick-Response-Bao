<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Style x:Key="QrbIcon16Style" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" />
  </Style>
  <Style x:Key="QrbIcon20Style" TargetType="ui:SymbolIcon" BasedOn="{StaticResource QrbIcon16Style}">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style x:Key="QrbIcon24Style" TargetType="ui:SymbolIcon" BasedOn="{StaticResource QrbIcon16Style}">
    <Setter Property="FontSize" Value="24" />
  </Style>
</ResourceDictionary>
