<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:QuickResponseBao.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Style x:Key="QrbFocusVisualStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource QrbFocusRingBrush}"
                  BorderThickness="{DynamicResource QrbFocusRingThickness}"
                  CornerRadius="{DynamicResource QrbRadius10}"
                  Margin="-3" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QrbButtonBaseStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="{DynamicResource QrbControlHeight36}" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource QrbControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource QrbFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource QrbRadius8}"
                  SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QrbSurfaceSecondaryBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QrbSelectionBrush}" />
              <Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource QrbFocusRingBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource QrbTextDisabledBrush}" />
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QrbDisabledBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QrbPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbButtonBaseStyle}">
    <Setter Property="Foreground" Value="{DynamicResource QrbTextOnAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource QrbAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QrbAccentBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource QrbAccentHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbAccentHoverBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource QrbAccentPressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbAccentPressedBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource QrbTextDisabledBrush}" /><Setter Property="Background" Value="{DynamicResource QrbDisabledBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbDisabledBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="QrbSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbButtonBaseStyle}" />
  <Style x:Key="QrbGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="QrbDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbButtonBaseStyle}">
    <Setter Property="Foreground" Value="{DynamicResource QrbErrorBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbErrorBrush}" />
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource QrbErrorSurfaceBrush}" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="QrbIconButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbGhostButtonStyle}">
    <Setter Property="MinWidth" Value="{DynamicResource QrbControlHeight36}" /><Setter Property="Width" Value="{DynamicResource QrbControlHeight36}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style x:Key="QrbAsyncButtonStyle" TargetType="controls:AsyncButton" BasedOn="{StaticResource QrbPrimaryButtonStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:AsyncButton">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource QrbRadius8}">
            <Grid Margin="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <StackPanel x:Name="Loading" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" />
                <ContentPresenter Content="{TemplateBinding LoadingContent}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsLoading" Value="True"><Setter TargetName="Content" Property="Visibility" Value="Collapsed" /><Setter TargetName="Loading" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource QrbTextDisabledBrush}" /><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QrbDisabledBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QrbTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" /><Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="{DynamicResource QrbControlHeight36}" /><Setter Property="Padding" Value="10,7" /><Setter Property="Margin" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource QrbTextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource QrbSelectionBrush}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource QrbFocusRingBrush}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="9,6" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource QrbTextDisabledBrush}" /><Setter Property="Background" Value="{DynamicResource QrbDisabledBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="QrbSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource QrbTextBoxStyle}"><Setter Property="MinHeight" Value="{DynamicResource QrbControlHeight40}" /></Style>
  <Style x:Key="QrbWpfUiComboBoxBaseStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
  <Style x:Key="QrbWpfUiToggleSwitchBaseStyle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}" />
  <Style x:Key="QrbWpfUiInfoBarBaseStyle" TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}" />
  <Style x:Key="QrbComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource QrbWpfUiComboBoxBaseStyle}">
    <Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" /><Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="{DynamicResource QrbControlHeight36}" /><Setter Property="Padding" Value="9,6" /><Setter Property="Margin" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource QrbFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="DropDownToggle" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          MinHeight="{TemplateBinding MinHeight}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" MinWidth="160"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1"
                          CornerRadius="{DynamicResource QrbRadius8}">
                    <Grid Margin="10,0,8,0">
                      <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" />
                      <ui:SymbolIcon Symbol="ChevronDown20" Style="{DynamicResource QrbIcon16Style}" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QrbSurfaceSecondaryBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource QrbFocusRingBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource QrbSurfaceBrush}" BorderBrush="{DynamicResource QrbBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource QrbRadius8}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Padding="4">
                <ScrollViewer><ItemsPresenter /></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource QrbFocusRingBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource QrbTextDisabledBrush}" /><Setter Property="Background" Value="{DynamicResource QrbDisabledBrush}" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="QrbCheckBoxStyle" TargetType="CheckBox"><Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" /><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource QrbFocusVisualStyle}" /><Setter Property="Margin" Value="4" /></Style>
  <Style x:Key="QrbToggleSwitchStyle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource QrbWpfUiToggleSwitchBaseStyle}"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource QrbFocusVisualStyle}" /><Setter Property="Margin" Value="4" /></Style>

  <Style x:Key="QrbCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource QrbSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource QrbRadius12}" />
    <Setter Property="Padding" Value="{DynamicResource QrbSpacing20}" /><Setter Property="Margin" Value="{DynamicResource QrbSpacing8}" />
  </Style>
  <Style x:Key="QrbStatusBadgeStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource QrbSurfaceSecondaryBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource QrbRadius12}" /><Setter Property="Padding" Value="10,4" /></Style>
  <Style x:Key="QrbSuccessBadgeStyle" TargetType="Border" BasedOn="{StaticResource QrbStatusBadgeStyle}"><Setter Property="Background" Value="{DynamicResource QrbSuccessSurfaceBrush}" /></Style>
  <Style x:Key="QrbWarningBadgeStyle" TargetType="Border" BasedOn="{StaticResource QrbStatusBadgeStyle}"><Setter Property="Background" Value="{DynamicResource QrbWarningSurfaceBrush}" /></Style>
  <Style x:Key="QrbErrorBadgeStyle" TargetType="Border" BasedOn="{StaticResource QrbStatusBadgeStyle}"><Setter Property="Background" Value="{DynamicResource QrbErrorSurfaceBrush}" /></Style>
  <Style x:Key="QrbEmptyStateStyle" TargetType="ContentControl"><Setter Property="Foreground" Value="{DynamicResource QrbTextSecondaryBrush}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="32" /></Style>
  <Style x:Key="QrbInfoBarStyle" TargetType="ui:InfoBar" BasedOn="{StaticResource QrbWpfUiInfoBarBaseStyle}"><Setter Property="Margin" Value="4" /></Style>
  <Style x:Key="QrbSettingRowStyle" TargetType="Grid">
    <Setter Property="Margin" Value="4,10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="controls:ResponsiveGrid.IsSettingRow" Value="True" />
  </Style>

  <!-- Current screens inherit the new system without changing behavior. -->
  <Style TargetType="Window"><Setter Property="FontFamily" Value="{DynamicResource QrbFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbBackgroundBrush}" /></Style>
  <Style TargetType="Button" BasedOn="{StaticResource QrbButtonBaseStyle}" />
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbPrimaryButtonStyle}" />
  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbDangerButtonStyle}" />
  <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource QrbGhostButtonStyle}"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Margin" Value="0,2" /><Setter Property="MinHeight" Value="42" /></Style>
  <Style x:Key="StatusPillStyle" TargetType="Border" BasedOn="{StaticResource QrbStatusBadgeStyle}" />
  <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource QrbCardStyle}" />
  <Style TargetType="TextBox" BasedOn="{StaticResource QrbTextBoxStyle}" />
  <Style TargetType="ComboBox" BasedOn="{StaticResource QrbComboBoxStyle}" />
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbSurfaceBrush}" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource QrbSelectionBrush}" /></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource QrbCheckBoxStyle}" />
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Margin" Value="4" /><Setter Property="FocusVisualStyle" Value="{StaticResource QrbFocusVisualStyle}" /></Style>
  <Style TargetType="TabControl"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" /></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbControlBrush}" /></Style>
  <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbSurfaceBrush}" /><Setter Property="RowBackground" Value="{DynamicResource QrbSurfaceBrush}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource QrbSurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource QrbGridLineBrush}" /></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource QrbSelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbGridLineBrush}" /></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbControlBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" /><Setter Property="Padding" Value="8" /></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" /></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource QrbSelectionBrush}" /></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollViewer"><Setter Property="Background" Value="Transparent" /></Style>
  <Style TargetType="{x:Type controls:ScrollablePageLayout}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:ScrollablePageLayout}">
          <ScrollViewer x:Name="PART_PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly" PanningDeceleration="0.001" PanningRatio="1" Focusable="False">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="{DynamicResource QrbSurfaceSecondaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource QrbTextSecondaryBrush}" /></Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource QrbAccentBrush}" /><Setter Property="Background" Value="{DynamicResource QrbDisabledBrush}" /><Setter Property="Height" Value="18" /></Style>
  <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{DynamicResource QrbTextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource QrbSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QrbBorderBrush}" /></Style>
  <Style x:Key="DiagnosticLabelStyle" TargetType="TextBlock"><Setter Property="Margin" Value="0,7,20,7" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource QrbTextSecondaryBrush}" /></Style>
  <Style x:Key="DiagnosticValueStyle" TargetType="TextBlock"><Setter Property="Margin" Value="0,7" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="ReadOnlyValueStyle" TargetType="TextBox" BasedOn="{StaticResource QrbTextBoxStyle}"><Setter Property="IsReadOnly" Value="True" /><Setter Property="IsReadOnlyCaretVisible" Value="True" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,7" /><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></Style>
</ResourceDictionary>
