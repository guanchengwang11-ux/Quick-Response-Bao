<Window x:Class="QuickResponseBao.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}" Width="1120" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="{DynamicResource AppName}" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="ListenerStatus" Text="{DynamicResource ListenerEnabled}" Foreground="{DynamicResource SuccessBrush}" Margin="1,4"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ListenerButton" Content="{DynamicResource Pause}" Click="ToggleListener_Click"/>
        <Button Content="{DynamicResource SwitchLanguage}" Click="SwitchLanguage_Click"/>
      </StackPanel>
    </DockPanel>

    <TabControl Grid.Row="1" x:Name="MainTabs" Background="{DynamicResource SurfaceBrush}">
      <TabItem Header="{DynamicResource Dashboard}">
        <ScrollViewer><StackPanel Margin="24">
          <TextBlock Text="{DynamicResource Running}" FontSize="22" FontWeight="SemiBold"/>
          <UniformGrid Columns="3" Margin="0,20">
            <Border Background="{DynamicResource CardBlueBrush}" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="{DynamicResource Summary}"/><TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="{DynamicResource CardGreenBrush}" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="{DynamicResource Enabled}"/><TextBlock Text="{Binding EnabledCount}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="{DynamicResource CardAmberBrush}" CornerRadius="8" Padding="18" Margin="5"><StackPanel><TextBlock Text="{DynamicResource Version}"/><TextBlock Text="1.0.0" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="{DynamicResource Privacy}" TextWrapping="Wrap" FontSize="15" MaxWidth="700" HorizontalAlignment="Left"/>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource Library}">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="LibraryToolbar">
            <DockPanel><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" ToolTip="{DynamicResource Search}"/></DockPanel>
            <WrapPanel HorizontalAlignment="Left">
              <Button Content="{DynamicResource Add}" Click="Add_Click"/><Button Content="{DynamicResource Edit}" Click="Edit_Click"/>
              <Button Content="{DynamicResource Import}" Click="Import_Click"/><Button Content="{DynamicResource Export}" Click="Export_Click"/>
              <Button Content="{DynamicResource Duplicate}" Click="Duplicate_Click"/><Button Content="{DynamicResource Toggle}" Click="ToggleResponse_Click"/>
              <Button Content="{DynamicResource Delete}" Click="Delete_Click"/>
              <Button Content="{DynamicResource Categories}" Click="Categories_Click"/><Button Content="{DynamicResource Backups}" Click="Backups_Click"/>
              <Button Content="{DynamicResource SelectAll}" Click="SelectAll_Click"/><Button Content="{DynamicResource ClearSelection}" Click="ClearSelection_Click"/>
              <Button Content="{DynamicResource BatchEnable}" Click="BatchEnable_Click"/><Button Content="{DynamicResource BatchDisable}" Click="BatchDisable_Click"/>
              <Button Content="{DynamicResource BatchMove}" Click="BatchMove_Click"/><Button Content="{DynamicResource BatchDelete}" Click="BatchDelete_Click"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="ResponsesGrid" Grid.Row="1" Margin="4,12" ItemsSource="{Binding Responses}" SelectedItem="{Binding SelectedResponse}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Summary}" Binding="{Binding Summary}" Width="2*"/>
              <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category}" Width="*"/>
              <DataGridTextColumn Header="{DynamicResource Language}" Binding="{Binding Language}" Width="*"/>
              <DataGridCheckBoxColumn Header="{DynamicResource Enabled}" Binding="{Binding IsEnabled}" Width="80"/>
              <DataGridTextColumn Header="{DynamicResource Usage}" Binding="{Binding UsageCount}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="{DynamicResource Empty}" Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVisibilityConverter}}" HorizontalAlignment="Center" Margin="12"/>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource Settings}">
        <ScrollViewer><Grid Margin="24" MaxWidth="820" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource GeneralSettings}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,16"/>
          <TextBlock Grid.Row="1" Text="{DynamicResource MinimumTrigger}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.MinimumTriggerLength}"/>
          <TextBlock Grid.Row="2" Text="{DynamicResource MaximumSuggestions}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MaximumSuggestions}"/>
          <TextBlock Grid.Row="3" Text="{DynamicResource ClipboardDelay}" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.ClipboardRestoreDelayMs}"/>
          <TextBlock Grid.Row="4" Text="{DynamicResource Whitelist}" VerticalAlignment="Top"/><TextBox x:Name="WhitelistText" Grid.Row="4" Grid.Column="1" Height="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Grid.Row="5" Text="{DynamicResource Theme}" VerticalAlignment="Center"/>
          <ComboBox x:Name="ThemeBox" Grid.Row="5" Grid.Column="1" SelectionChanged="ThemeBox_SelectionChanged">
            <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}"/><ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}"/><ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}"/>
          </ComboBox>
          <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{DynamicResource UpdateSettings}" FontSize="18" FontWeight="SemiBold" Margin="4,16,4,6"/>
          <CheckBox x:Name="StartupUpdateCheckBox" Grid.Row="7" Grid.Column="1" Content="{DynamicResource CheckUpdatesOnStartup}" IsChecked="{Binding Settings.CheckUpdatesOnStartup}"/>
          <TextBlock Grid.Row="8" Text="{DynamicResource UpdateBehavior}" VerticalAlignment="Center"/>
          <ComboBox x:Name="UpdateBehaviorBox" Grid.Row="8" Grid.Column="1"><ComboBoxItem Tag="Notify" Content="{DynamicResource NotifyOnly}"/><ComboBoxItem Tag="Download" Content="{DynamicResource AutoDownload}"/></ComboBox>
          <CheckBox x:Name="PrereleaseCheckBox" Grid.Row="9" Grid.Column="1" Content="{DynamicResource IncludePrerelease}" IsChecked="{Binding Settings.IncludePrereleaseUpdates}"/>
          <Button x:Name="SaveSettingsButton" Grid.Row="10" Grid.Column="1" Content="{DynamicResource Save}" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
        </Grid></ScrollViewer>
      </TabItem>

      <TabItem x:Name="DiagnosticsTab" Header="{DynamicResource Diagnostics}">
        <ScrollViewer><Grid Margin="24" MaxWidth="900" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource DiagnosticsTitle}" FontSize="22" FontWeight="SemiBold" Margin="4,0,4,14"/>
          <TextBlock Grid.Row="1" Text="{DynamicResource ForegroundProcess}"/><TextBlock x:Name="ForegroundProcessValue" Grid.Row="1" Grid.Column="1"/>
          <TextBlock Grid.Row="2" Text="{DynamicResource WindowTitle}"/><TextBlock x:Name="WindowTitleValue" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="3" Text="{DynamicResource WhitelistState}"/><TextBlock x:Name="WhitelistStateValue" Grid.Row="3" Grid.Column="1"/>
          <TextBlock Grid.Row="4" Text="{DynamicResource HookState}"/><TextBlock x:Name="HookStateValue" Grid.Row="4" Grid.Column="1"/>
          <TextBlock Grid.Row="5" Text="{DynamicResource TextInputState}"/><TextBlock x:Name="TextInputStateValue" Grid.Row="5" Grid.Column="1"/>
          <TextBlock Grid.Row="6" Text="{DynamicResource BufferLength}"/><TextBlock x:Name="BufferLengthValue" Grid.Row="6" Grid.Column="1"/>
          <TextBlock Grid.Row="7" Text="{DynamicResource PositionMethod}"/><TextBlock x:Name="PositionMethodValue" Grid.Row="7" Grid.Column="1"/>
          <TextBlock Grid.Row="8" Text="{DynamicResource LastPasteState}"/><TextBlock x:Name="LastPasteValue" Grid.Row="8" Grid.Column="1"/>
          <TextBlock Grid.Row="9" Text="{DynamicResource LastFailure}"/><TextBlock x:Name="LastFailureValue" Grid.Row="9" Grid.Column="1" TextWrapping="Wrap"/>
          <WrapPanel x:Name="DiagnosticActions" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,18,0,0">
            <Button Content="{DynamicResource TestCandidate}" Click="TestCandidate_Click"/><Button Content="{DynamicResource TestPaste}" Click="TestPaste_Click"/>
            <Button Content="{DynamicResource OpenLogs}" Click="OpenLogs_Click"/><Button Content="{DynamicResource ExportDiagnostics}" Click="ExportDiagnostics_Click"/>
          </WrapPanel>
        </Grid></ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource About}">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource AppName}" FontSize="28" FontWeight="Bold"/><TextBlock Text="{DynamicResource Version}" FontSize="16" Margin="0,6,0,18"/>
          <TextBlock Text="{DynamicResource Privacy}" TextWrapping="Wrap" FontSize="15"/>
          <Button Content="GitHub Repository" Click="OpenRepository_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/>
          <Button x:Name="CheckUpdatesButton" Content="{DynamicResource CheckUpdates}" Click="CheckUpdates_Click" HorizontalAlignment="Left"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" x:Name="FeedbackText" Margin="4,10,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
  </Grid>
</Window>
