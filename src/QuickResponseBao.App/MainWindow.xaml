<ui:FluentWindow x:Class="QuickResponseBao.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource AppName}" Width="1200" Height="780" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen" Icon="/assets/branding/QuickResponseBao.ico"
                 WindowBackdropType="None" ExtendsContentIntoTitleBar="True">
  <Grid>
  <ui:NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" TitleBar="{Binding ElementName=AppTitleBar}"
                     OpenPaneLength="232" CompactPaneLength="52"
                     IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False"
                     IsPaneOpen="True" IsFooterSeparatorVisible="True"
                     AlwaysShowHeader="True" HeaderVisibility="Visible"
                     FrameMargin="0" Transition="None">
    <ui:NavigationView.Header>
      <Grid x:Name="PageHeader" Margin="8,12,24,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitle" Style="{DynamicResource QrbPageTitleTextStyle}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="ListenerPill" Style="{DynamicResource QrbStatusBadgeStyle}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon x:Name="ListenerStatusIcon" Symbol="Circle24" Style="{DynamicResource QrbIcon16Style}" Margin="0,0,6,0" />
              <TextBlock x:Name="ListenerStatus" VerticalAlignment="Center" Style="{DynamicResource QrbBodyStrongTextStyle}" />
            </StackPanel>
          </Border>
          <Button x:Name="ListenerButton" Style="{DynamicResource QrbSecondaryButtonStyle}" Click="ToggleListener_Click" />
        </StackPanel>
      </Grid>
    </ui:NavigationView.Header>

    <ui:NavigationView.PaneHeader>
      <Grid Margin="4,8,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="PaneToggleButton" AutomationProperties.AutomationId="QrbPaneToggleButton" Style="{DynamicResource QrbIconButtonStyle}" Click="TogglePane_Click" ToolTip="{DynamicResource NavigationMenu}">
          <ui:SymbolIcon Symbol="Navigation24" Style="{DynamicResource QrbIcon20Style}"/>
        </Button>
        <Image Grid.Column="1" Source="/assets/branding/quick-response-bao-icon.png" Width="28" Height="28" VerticalAlignment="Center">
          <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
        </Image>
        <TextBlock Grid.Column="2" Text="Quick Response Bao" VerticalAlignment="Center" Margin="9,0,0,0">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QrbBodyStrongTextStyle}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </ui:NavigationView.PaneHeader>

    <ui:NavigationView.MenuItems>
      <ui:NavigationViewItem x:Name="DashboardItem" Content="{DynamicResource Dashboard}" TargetPageTag="Dashboard" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
      <ui:NavigationViewItem Content="{DynamicResource Library}" TargetPageTag="Library" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="BookOpen24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
      <ui:NavigationViewItem Content="{DynamicResource Categories}" TargetPageTag="Categories" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Tag24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
      <ui:NavigationViewItem Content="{DynamicResource ImportExport}" TargetPageTag="ImportExport" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ArrowImport24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
      <ui:NavigationViewItem Content="{DynamicResource ApplicationWhitelist}" TargetPageTag="Applications" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Apps24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
      <ui:NavigationViewItem Content="{DynamicResource Diagnostics}" TargetPageTag="Diagnostics" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Wrench24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
    </ui:NavigationView.MenuItems>

    <ui:NavigationView.FooterMenuItems>
      <ui:NavigationViewItem Content="{DynamicResource Settings}" TargetPageTag="Settings" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
      <ui:NavigationViewItem Content="{DynamicResource About}" TargetPageTag="About" Click="NavigationItem_Click"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
    </ui:NavigationView.FooterMenuItems>

    <ui:NavigationView.ContentOverlay>
      <Border x:Name="FeedbackHost" Background="{DynamicResource QrbSurfaceBrush}" BorderBrush="{DynamicResource QrbBorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource QrbRadius10}" Padding="0" Margin="248,0,24,16" MaxWidth="620" HorizontalAlignment="Center"
              VerticalAlignment="Bottom" Visibility="Collapsed">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="FeedbackAccent" Background="{DynamicResource QrbSuccessBrush}" CornerRadius="10,0,0,10"/>
          <ui:SymbolIcon x:Name="FeedbackIcon" Grid.Column="1" Symbol="CheckmarkCircle24" Foreground="{DynamicResource QrbSuccessBrush}" Margin="14,0,8,0"/>
          <StackPanel Grid.Column="2" Margin="0,11"><TextBlock x:Name="FeedbackText" Style="{DynamicResource QrbBodyStrongTextStyle}" TextWrapping="Wrap"/><TextBlock x:Name="FeedbackDetails" Style="{DynamicResource QrbCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{DynamicResource QrbIconButtonStyle}" ToolTip="{DynamicResource Copy}" Click="CopyFeedback_Click"><ui:SymbolIcon Symbol="Document24" Style="{DynamicResource QrbIcon16Style}" /></Button><Button Style="{DynamicResource QrbIconButtonStyle}" ToolTip="{DynamicResource Close}" Click="CloseFeedback_Click"><ui:SymbolIcon Symbol="Dismiss24" Style="{DynamicResource QrbIcon16Style}" /></Button></StackPanel>
        </Grid>
      </Border>
    </ui:NavigationView.ContentOverlay>
  </ui:NavigationView>
  <ui:TitleBar x:Name="AppTitleBar" Title="" />
  </Grid>
</ui:FluentWindow>
