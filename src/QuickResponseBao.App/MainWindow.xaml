<Window x:Class="QuickResponseBao.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}" Width="1220" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/assets/branding/QuickResponseBao.ico">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="4,8,4,22">
          <Image Source="/assets/branding/quick-response-bao-icon.png" Width="48" Height="48" HorizontalAlignment="Left"/>
          <TextBlock Text="{DynamicResource AppName}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel>
          <Button x:Name="DashboardNav" Style="{StaticResource NavButtonStyle}" Tag="0" Content="{DynamicResource Dashboard}" Click="Navigate_Click"/>
          <Button x:Name="LibraryNav" Style="{StaticResource NavButtonStyle}" Tag="1" Content="{DynamicResource Library}" Click="Navigate_Click"/>
          <Button x:Name="CategoriesNav" Style="{StaticResource NavButtonStyle}" Tag="2" Content="{DynamicResource Categories}" Click="Navigate_Click"/>
          <Button x:Name="ImportExportNav" Style="{StaticResource NavButtonStyle}" Tag="3" Content="{DynamicResource ImportExport}" Click="Navigate_Click"/>
          <Button x:Name="WhitelistNav" Style="{StaticResource NavButtonStyle}" Tag="4" Content="{DynamicResource ApplicationWhitelist}" Click="Navigate_Click"/>
          <Button x:Name="DiagnosticsNav" Style="{StaticResource NavButtonStyle}" Tag="5" Content="{DynamicResource Diagnostics}" Click="Navigate_Click"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}" Tag="6" Content="{DynamicResource Settings}" Click="Navigate_Click"/>
          <Button x:Name="AboutNav" Style="{StaticResource NavButtonStyle}" Tag="7" Content="{DynamicResource About}" Click="Navigate_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="24,18,24,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="{DynamicResource Dashboard}" FontSize="26" FontWeight="SemiBold"/>
          <Border x:Name="ListenerPill" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left" Margin="0,7,0,0">
            <TextBlock x:Name="ListenerStatus" Text="{DynamicResource ListenerEnabled}" Foreground="{DynamicResource SuccessBrush}"/>
          </Border>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="ListenerButton" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Pause}" Click="ToggleListener_Click"/>
          <ComboBox x:Name="ThemeBox" MinWidth="150" SelectionChanged="ThemeBox_SelectionChanged">
            <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}"/><ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}"/><ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}"/>
          </ComboBox>
          <Button Content="{DynamicResource SwitchLanguage}" Click="SwitchLanguage_Click"/>
        </WrapPanel>
      </Grid>

      <TabControl Grid.Row="1" x:Name="MainTabs" Background="Transparent" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
          </ControlTemplate>
        </TabControl.Template>

        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <UniformGrid Columns="4" Margin="-6,0,-6,18">
              <Border Style="{StaticResource CardStyle}" Background="{DynamicResource CardBlueBrush}"><StackPanel><TextBlock Text="{DynamicResource ListeningStatus}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="DashboardListenerStatus" Text="{DynamicResource ListenerEnabled}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Background="{DynamicResource CardGreenBrush}"><StackPanel><TextBlock Text="{DynamicResource TotalResponses}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding TotalCount}" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Background="{DynamicResource CardAmberBrush}"><StackPanel><TextBlock Text="{DynamicResource TodayUsage}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding TodayUsageCount}" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Version}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="DashboardVersionValue" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource CardStyle}" Margin="0">
              <StackPanel><TextBlock Text="{DynamicResource RecentResponses}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding RecentResponses}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,10"><StackPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>
        </TabItem>

        <TabItem>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="LibraryToolbar">
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" ToolTip="{DynamicResource Search}" HorizontalAlignment="Stretch"/>
              <WrapPanel>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Add}" Click="Add_Click"/><Button Content="{DynamicResource Edit}" Click="Edit_Click"/>
                <Button Content="{DynamicResource Duplicate}" Click="Duplicate_Click"/><Button Content="{DynamicResource Toggle}" Click="ToggleResponse_Click"/>
                <Button Content="{DynamicResource SelectAll}" Click="SelectAll_Click"/><Button Content="{DynamicResource ClearSelection}" Click="ClearSelection_Click"/>
                <Button Content="{DynamicResource BatchEnable}" Click="BatchEnable_Click"/><Button Content="{DynamicResource BatchDisable}" Click="BatchDisable_Click"/>
                <Button Content="{DynamicResource BatchMove}" Click="BatchMove_Click"/><Button Style="{StaticResource DangerButtonStyle}" Content="{DynamicResource BatchDelete}" Click="BatchDelete_Click"/>
                <Button Style="{StaticResource DangerButtonStyle}" Content="{DynamicResource Delete}" Click="Delete_Click"/>
              </WrapPanel>
            </StackPanel>
            <DataGrid x:Name="ResponsesGrid" Grid.Row="1" Margin="4,12" ItemsSource="{Binding Responses}" SelectedItem="{Binding SelectedResponse}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Summary}" Binding="{Binding Summary}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Language}" Binding="{Binding Language}" Width="*"/>
                <DataGridCheckBoxColumn Header="{DynamicResource Enabled}" Binding="{Binding IsEnabled}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource Usage}" Binding="{Binding UsageCount}" Width="90"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="{DynamicResource Empty}" Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVisibilityConverter}}" HorizontalAlignment="Center" Margin="12"/>
          </Grid>
        </TabItem>

        <TabItem>
          <ScrollViewer><StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource CategoryManagementHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="15"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource OpenCategoryManager}" Click="Categories_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>
          </StackPanel></ScrollViewer>
        </TabItem>

        <TabItem>
          <ScrollViewer><StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource ImportExportHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="15"/>
            <WrapPanel Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Import}" Click="Import_Click"/><Button Content="{DynamicResource Export}" Click="Export_Click"/></WrapPanel>
          </StackPanel></ScrollViewer>
        </TabItem>

        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource WhitelistHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBox x:Name="WhitelistText" Grid.Row="1" Height="180" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,14,0,8"/>
            <WrapPanel Grid.Row="2"><Button x:Name="CaptureProcessButton" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource CaptureForegroundApplication}" Click="CaptureProcess_Click"/><Button Content="{DynamicResource RefreshRunningApplications}" Click="RefreshProcesses_Click"/></WrapPanel>
            <ComboBox x:Name="RunningProcessesBox" Grid.Row="3" Margin="0,10,0,6" MinWidth="360" HorizontalAlignment="Stretch"/>
            <WrapPanel Grid.Row="4"><Button Content="{DynamicResource AddSelectedApplication}" Click="AddSelectedProcess_Click"/><Button Content="{DynamicResource SaveWhitelist}" Click="SaveWhitelist_Click"/></WrapPanel>
          </Grid></ScrollViewer>
        </TabItem>

        <TabItem x:Name="DiagnosticsTab">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="900" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource ForegroundProcess}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBox x:Name="ForegroundProcessValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyValueStyle}"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource FocusProcess}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBox x:Name="FocusProcessValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyValueStyle}"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource WindowTitle}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBox x:Name="WindowTitleValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyValueStyle}"/>
            <TextBlock Grid.Row="3" Text="{DynamicResource WhitelistState}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="WhitelistStateValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="4" Text="{DynamicResource HookState}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="HookStateValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="5" Text="{DynamicResource TextInputDetected}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="TextInputStateValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="6" Text="{DynamicResource TextInputUnknown}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="TextInputUnknownValue" Grid.Row="6" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="7" Text="{DynamicResource PasswordFieldDetected}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="PasswordFieldValue" Grid.Row="7" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="8" Text="{DynamicResource UiAutomationUnavailable}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="UiAutomationValue" Grid.Row="8" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="9" Text="{DynamicResource BufferLength}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="BufferLengthValue" Grid.Row="9" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="10" Text="{DynamicResource PositionMethod}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="PositionMethodValue" Grid.Row="10" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="11" Text="{DynamicResource LastPasteState}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="LastPasteValue" Grid.Row="11" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="12" Text="{DynamicResource PasteSentCount}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="PasteSentCountValue" Grid.Row="12" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="13" Text="{DynamicResource PasteErrorCode}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="PasteErrorCodeValue" Grid.Row="13" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="14" Text="{DynamicResource PasteInputSize}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="PasteInputSizeValue" Grid.Row="14" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="15" Text="{DynamicResource PasteTargetProcess}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBox x:Name="PasteTargetProcessValue" Grid.Row="15" Grid.Column="1" Style="{StaticResource ReadOnlyValueStyle}"/>
            <TextBlock Grid.Row="16" Text="{DynamicResource PasteSamePermission}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="PastePermissionValue" Grid.Row="16" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="17" Text="{DynamicResource LastFailure}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBox x:Name="LastFailureValue" Grid.Row="17" Grid.Column="1" Style="{StaticResource ReadOnlyValueStyle}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="18" Text="{DynamicResource ClipboardRestored}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBlock x:Name="ClipboardRestoredValue" Grid.Row="18" Grid.Column="1" Style="{StaticResource DiagnosticValueStyle}"/>
            <TextBlock Grid.Row="19" Text="{DynamicResource LogDirectory}" Style="{StaticResource DiagnosticLabelStyle}"/><TextBox x:Name="LogDirectoryValue" Grid.Row="19" Grid.Column="1" Style="{StaticResource ReadOnlyValueStyle}" TextWrapping="Wrap"/>
            <WrapPanel x:Name="DiagnosticActions" Grid.Row="20" Grid.ColumnSpan="2" Margin="0,18,0,0">
              <Button Content="{DynamicResource TestCandidate}" Click="TestCandidate_Click"/><Button Content="{DynamicResource TestPaste}" Click="TestPaste_Click"/><Button Content="{DynamicResource OpenLogs}" Click="OpenLogs_Click"/><Button Content="{DynamicResource ExportDiagnostics}" Click="ExportDiagnostics_Click"/>
            </WrapPanel>
          </Grid></ScrollViewer>
        </TabItem>

        <TabItem>
          <ScrollViewer><Grid MaxWidth="820" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource GeneralSettings}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,16"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource MinimumTrigger}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.MinimumTriggerLength}"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource MaximumSuggestions}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MaximumSuggestions}"/>
            <TextBlock Grid.Row="3" Text="{DynamicResource ClipboardDelay}" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.ClipboardRestoreDelayMs}"/>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{DynamicResource UpdateSettings}" FontSize="18" FontWeight="SemiBold" Margin="4,20,4,8"/>
            <CheckBox x:Name="StartupUpdateCheckBox" Grid.Row="5" Grid.Column="1" Content="{DynamicResource CheckUpdatesOnStartup}" IsChecked="{Binding Settings.CheckUpdatesOnStartup}"/>
            <TextBlock Grid.Row="6" Text="{DynamicResource UpdateBehavior}" VerticalAlignment="Center"/><ComboBox x:Name="UpdateBehaviorBox" Grid.Row="6" Grid.Column="1"><ComboBoxItem Tag="Notify" Content="{DynamicResource NotifyOnly}"/><ComboBoxItem Tag="Download" Content="{DynamicResource AutoDownload}"/></ComboBox>
            <CheckBox x:Name="PrereleaseCheckBox" Grid.Row="7" Grid.Column="1" Content="{DynamicResource IncludePrerelease}" IsChecked="{Binding Settings.IncludePrereleaseUpdates}"/>
            <WrapPanel Grid.Row="8" Grid.Column="1"><Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Save}" Click="SaveSettings_Click"/><Button Content="{DynamicResource Backups}" Click="Backups_Click"/></WrapPanel>
          </Grid></ScrollViewer>
        </TabItem>

        <TabItem>
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Image Source="/assets/branding/quick-response-bao-icon.png" Width="80" Height="80" HorizontalAlignment="Left"/>
            <TextBlock Text="{DynamicResource AppName}" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock x:Name="AboutVersionValue" FontSize="16" Margin="0,6,0,18"/>
            <TextBlock Text="{DynamicResource Privacy}" TextWrapping="Wrap" FontSize="15"/>
            <WrapPanel Margin="0,18,0,0"><Button Content="{DynamicResource GitHubRepository}" Click="OpenRepository_Click"/><Button x:Name="CheckUpdatesButton" Content="{DynamicResource CheckUpdates}" Click="CheckUpdates_Click"/></WrapPanel>
          </StackPanel>
        </TabItem>
      </TabControl>

      <Border Grid.Row="2" x:Name="FeedbackHost" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Copy}" Click="CopyFeedback_Click" MinWidth="64"/><TextBlock x:Name="FeedbackText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
