<Page x:Class="QuickResponseBao.App.Views.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="{DynamicResource QrbBackgroundBrush}">
  <Grid x:Name="RootPanel" Margin="24,8,24,24" MaxWidth="1120" HorizontalAlignment="Center">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{DynamicResource CategoryManagementHint}" Style="{DynamicResource QrbBodyTextStyle}"/><TextBlock Text="{DynamicResource CategoryOrderHint}" Style="{DynamicResource QrbCaptionTextStyle}" Margin="0,4,0,0"/></StackPanel>
      <Button Grid.Column="1" Style="{DynamicResource QrbPrimaryButtonStyle}" Click="Add_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Style="{DynamicResource QrbIcon16Style}" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource NewCategory}"/></StackPanel></Button>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource QrbSurfaceBrush}" BorderBrush="{DynamicResource QrbBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
      <DataGrid x:Name="CategoriesGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0" RowHeight="58" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category.Name}" Width="2*" MinWidth="220"/>
          <DataGridTextColumn Header="{DynamicResource Responses}" Binding="{Binding ResponseCount}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="{DynamicResource Order}" Binding="{Binding Category.SortOrder}" Width="*" MinWidth="100"/>
          <DataGridTemplateColumn Header="{DynamicResource Actions}" Width="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Rename}" Style="{DynamicResource QrbGhostButtonStyle}" Click="Rename_Click"/>
            <Button Style="{DynamicResource QrbIconButtonStyle}" ToolTip="{DynamicResource MoveUp}" Click="Up_Click"><ui:SymbolIcon Symbol="ArrowUp12" Style="{DynamicResource QrbIcon16Style}"/></Button>
            <Button Style="{DynamicResource QrbIconButtonStyle}" ToolTip="{DynamicResource MoveDown}" Click="Down_Click"><ui:SymbolIcon Symbol="ArrowDown12" Style="{DynamicResource QrbIcon16Style}"/></Button>
            <Button Content="{DynamicResource Delete}" Style="{DynamicResource QrbDangerButtonStyle}" Click="Delete_Click"/>
          </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Page>
