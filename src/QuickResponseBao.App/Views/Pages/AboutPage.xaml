<Page x:Class="QuickResponseBao.App.Views.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource QrbBackgroundBrush}">
  <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left"><Image Source="/assets/branding/quick-response-bao-icon.png" Width="72" Height="72" HorizontalAlignment="Left"/><TextBlock Text="Quick Response Bao" Style="{DynamicResource QrbPageTitleTextStyle}" Margin="0,12,0,0"/><TextBlock x:Name="VersionValue" Style="{DynamicResource QrbBodyStrongTextStyle}" Margin="0,4,0,16"/><TextBlock Text="{DynamicResource Privacy}" Style="{DynamicResource QrbBodyTextStyle}"/><WrapPanel Margin="0,18,0,0"><Button Content="{DynamicResource GitHubRepository}" Click="Repository_Click"/><Button Content="{DynamicResource CheckUpdates}" Style="{DynamicResource QrbPrimaryButtonStyle}" Click="Update_Click"/></WrapPanel></StackPanel>
</Page>
