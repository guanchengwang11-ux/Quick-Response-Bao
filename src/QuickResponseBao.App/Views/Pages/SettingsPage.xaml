<Page x:Class="QuickResponseBao.App.Views.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:QuickResponseBao.App.Controls" Background="{DynamicResource QrbBackgroundBrush}">
  <controls:ScrollablePageLayout><StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Left">
    <TextBlock Text="{DynamicResource SettingsIntro}" Style="{DynamicResource QrbBodyTextStyle}" Margin="8,0,8,12"/>
    <Border Style="{DynamicResource QrbCardStyle}"><StackPanel><TextBlock Text="{DynamicResource General}" Style="{DynamicResource QrbSectionTitleTextStyle}"/>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource Language}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource LanguageDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ComboBox x:Name="LanguageBox" Grid.Column="1" Width="190" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="en-US" Content="English"/></ComboBox></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource StartWithWindows}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource StartWithWindowsDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.StartWithWindows}" Checked="ImmediateSetting_Changed" Unchecked="ImmediateSetting_Changed"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource MinimizeToTray}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource MinimizeToTrayDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.MinimizeToTrayOnClose}" Checked="ImmediateSetting_Changed" Unchecked="ImmediateSetting_Changed"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource StartMinimized}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource StartMinimizedDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.StartMinimized}" Checked="ImmediateSetting_Changed" Unchecked="ImmediateSetting_Changed"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource Notifications}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource NotificationsDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowNotifications}" Checked="ImmediateSetting_Changed" Unchecked="ImmediateSetting_Changed"/></Grid>
    </StackPanel></Border>
    <Border Style="{DynamicResource QrbCardStyle}"><StackPanel><TextBlock Text="{DynamicResource SettingsSearch}" Style="{DynamicResource QrbSectionTitleTextStyle}"/>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource GlobalSearch}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource GlobalSearchDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.GlobalSearchEnabled}"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><TextBlock Text="{DynamicResource MinimumTrigger}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBox Grid.Column="1" Width="100" Text="{Binding Settings.MinimumTriggerLength}"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><TextBlock Text="{DynamicResource MaximumSuggestions}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBox Grid.Column="1" Width="100" Text="{Binding Settings.MaximumSuggestions}"/></Grid>
      <TextBlock Text="{DynamicResource SearchFields}" Style="{DynamicResource QrbBodyStrongTextStyle}" Margin="4,10,4,4"/><WrapPanel><CheckBox Content="{DynamicResource Summary}" IsChecked="{Binding Settings.MatchSummary}"/><CheckBox Content="{DynamicResource ResponseBody}" IsChecked="{Binding Settings.MatchContent}"/><CheckBox Content="{DynamicResource Keywords}" IsChecked="{Binding Settings.MatchKeywords}"/><CheckBox Content="{DynamicResource Category}" IsChecked="{Binding Settings.MatchCategory}"/><CheckBox Content="{DynamicResource SortByUsage}" IsChecked="{Binding Settings.SortByUsage}"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{DynamicResource QrbCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Paste}" Style="{DynamicResource QrbSectionTitleTextStyle}"/>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource ReplaceTypedSearchText}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource ReplaceTypedSearchTextDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ReplaceTypedSearchText}"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource PreserveClipboard}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource PreserveClipboardDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PreserveClipboard}"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource RestoreClipboard}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource RestoreClipboardDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.RestoreClipboard}"/></Grid>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><TextBlock Text="{DynamicResource ClipboardDelay}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBox Grid.Column="1" Width="100" Text="{Binding Settings.ClipboardRestoreDelayMs}"/></Grid>
      <Button Content="{DynamicResource TestPaste}" Style="{DynamicResource QrbSecondaryButtonStyle}" HorizontalAlignment="Left" Click="TestPaste_Click"/>
    </StackPanel></Border>
    <Border Style="{DynamicResource QrbCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Appearance}" Style="{DynamicResource QrbSectionTitleTextStyle}"/>
      <Grid Style="{DynamicResource QrbSettingRowStyle}"><StackPanel><TextBlock Text="{DynamicResource Theme}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{DynamicResource ThemeDescription}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel><ComboBox x:Name="ThemeBox" Grid.Column="1" Width="190" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}"/><ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}"/><ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}"/></ComboBox></Grid>
      <ui:InfoBar IsOpen="True" Severity="Informational" Title="{DynamicResource HighContrast}" Message="{DynamicResource HighContrastDescription}" IsClosable="False"/>
    </StackPanel></Border>
    <Border Style="{DynamicResource QrbCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Updates}" Style="{DynamicResource QrbSectionTitleTextStyle}"/><TextBlock Text="{Binding CurrentVersionLabel}" Style="{DynamicResource QrbCaptionTextStyle}"/>
      <CheckBox Content="{DynamicResource CheckUpdatesOnStartup}" IsChecked="{Binding Settings.CheckUpdatesOnStartup}"/><CheckBox Content="{DynamicResource AutoDownload}" IsChecked="{Binding Settings.AutoDownloadUpdates}"/><CheckBox Content="{DynamicResource IncludePrerelease}" IsChecked="{Binding Settings.IncludePrereleaseUpdates}"/>
      <Button Content="{DynamicResource CheckUpdates}" Style="{DynamicResource QrbSecondaryButtonStyle}" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
    </StackPanel></Border>
    <Border Style="{DynamicResource QrbCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Privacy}" Style="{DynamicResource QrbSectionTitleTextStyle}"/><TextBlock Text="{DynamicResource PrivacyLocalStatement}" Style="{DynamicResource QrbBodyTextStyle}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource OpenDataFolder}" Click="Data_Click"/><Button Content="{DynamicResource OpenLogs}" Click="Logs_Click"/><Button Content="{DynamicResource Backups}" Click="Backups_Click"/></WrapPanel>
    </StackPanel></Border>
    <DockPanel Margin="8,8,8,24"><TextBlock x:Name="SaveState" Text="{DynamicResource UnsavedChanges}" Foreground="{DynamicResource QrbTextSecondaryBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{DynamicResource Save}" Style="{DynamicResource QrbPrimaryButtonStyle}" Click="Save_Click"/></DockPanel>
  </StackPanel></controls:ScrollablePageLayout>
</Page>
