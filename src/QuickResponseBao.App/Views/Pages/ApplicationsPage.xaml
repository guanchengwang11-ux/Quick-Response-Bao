<Page x:Class="QuickResponseBao.App.Views.Pages.ApplicationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="{DynamicResource QrbBackgroundBrush}">
  <Grid Margin="24" MaxWidth="960" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="8,0,8,12"><StackPanel><TextBlock Text="{DynamicResource ApplicationsIntro}" Style="{DynamicResource QrbBodyTextStyle}"/><TextBlock Text="{DynamicResource ApplicationsPrivacyHint}" Style="{DynamicResource QrbCaptionTextStyle}" Margin="0,4,0,0"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Content="{DynamicResource AddRunningApplication}" Style="{DynamicResource QrbPrimaryButtonStyle}" Click="Running_Click"/><Button Content="{DynamicResource BrowseExe}" Style="{DynamicResource QrbSecondaryButtonStyle}" Click="Browse_Click"/></WrapPanel></DockPanel>
    <Border Grid.Row="1" Style="{DynamicResource QrbCardStyle}" Padding="0"><ListBox x:Name="ApplicationsList" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" Background="{DynamicResource QrbSurfaceSecondaryBrush}" CornerRadius="8"><ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource QrbAccentBrush}"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding DisplayName}" Style="{DynamicResource QrbBodyStrongTextStyle}"/><TextBlock Text="{Binding ProcessName}" Style="{DynamicResource QrbCaptionTextStyle}"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ProcessName}" VerticalAlignment="Center" Foreground="{DynamicResource QrbTextSecondaryBrush}"/>
        <CheckBox Grid.Column="3" Content="{DynamicResource Enabled}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Click="Enabled_Click"/>
        <Button Grid.Column="4" Content="{DynamicResource Remove}" Style="{DynamicResource QrbGhostButtonStyle}" Tag="{Binding}" Click="Remove_Click"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox></Border>
    <TextBlock x:Name="EmptyState" Grid.Row="1" Text="{DynamicResource NoAllowedApplications}" Style="{DynamicResource QrbCaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    <TextBlock Grid.Row="2" Text="{DynamicResource WhitelistCaseInsensitive}" Style="{DynamicResource QrbCaptionTextStyle}" Margin="8"/>
  </Grid>
</Page>
