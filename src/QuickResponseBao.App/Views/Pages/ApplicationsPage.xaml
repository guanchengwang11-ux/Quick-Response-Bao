<Page x:Class="QuickResponseBao.App.Views.Pages.ApplicationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource QrbBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Left">
    <TextBlock Text="{DynamicResource WhitelistHint}" Style="{DynamicResource QrbBodyTextStyle}"/>
    <TextBox x:Name="WhitelistText" Height="180" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,16,0,8"/>
    <WrapPanel><Button x:Name="CaptureButton" Content="{DynamicResource CaptureForegroundApplication}" Style="{DynamicResource QrbPrimaryButtonStyle}" Click="Capture_Click"/><Button Content="{DynamicResource RefreshRunningApplications}" Style="{DynamicResource QrbSecondaryButtonStyle}" Click="Refresh_Click"/></WrapPanel>
    <ComboBox x:Name="ProcessesBox" Margin="4,12,4,4" MinWidth="380"/>
    <WrapPanel><Button Content="{DynamicResource AddSelectedApplication}" Click="Add_Click"/><Button Content="{DynamicResource SaveWhitelist}" Click="Save_Click"/></WrapPanel>
  </StackPanel></ScrollViewer>
</Page>
