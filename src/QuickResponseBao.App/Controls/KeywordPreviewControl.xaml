<UserControl x:Class="QuickResponseBao.App.Controls.KeywordPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <ItemsControl ItemsSource="{Binding VisibleKeywords, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{DynamicResource QrbStatusBadgeStyle}" Padding="7,2" Margin="0,0,4,0">
          <TextBlock Text="{Binding}" Style="{DynamicResource QrbCaptionTextStyle}"/>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border x:Name="MoreBadge" Style="{DynamicResource QrbStatusBadgeStyle}" Padding="7,2" Visibility="Collapsed">
      <TextBlock x:Name="MoreText" Style="{DynamicResource QrbCaptionTextStyle}"/>
    </Border>
  </StackPanel>
</UserControl>
