<Window x:Class="QuickResponseBao.App.ImportPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ImportPreview}" Width="980" Height="650" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource PreviewRows}" FontSize="20" FontWeight="SemiBold" Margin="4"/>
    <DataGrid x:Name="PreviewGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" Margin="4,8"/>
    <TextBlock Grid.Row="2" Text="{DynamicResource MapFields}" FontSize="18" FontWeight="SemiBold" Margin="4,10,4,4"/>
    <UniformGrid Grid.Row="3" Columns="2" Margin="4">
      <StackPanel Margin="4"><TextBlock Text="{DynamicResource Summary}"/><ComboBox x:Name="SummaryBox"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="{DynamicResource Content}"/><ComboBox x:Name="ContentBox"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="{DynamicResource Keywords}"/><ComboBox x:Name="KeywordsBox"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="{DynamicResource Category}"/><ComboBox x:Name="CategoryBox"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="{DynamicResource Language}"/><ComboBox x:Name="LanguageBox"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="{DynamicResource IsEnabled}"/><ComboBox x:Name="EnabledBox"/></StackPanel>
    </UniformGrid>
    <DockPanel Grid.Row="4"><TextBlock x:Name="SummaryText" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource StartImport}" Click="Import_Click" IsDefault="True"/><Button Content="{DynamicResource Cancel}" IsCancel="True"/></StackPanel></DockPanel>
  </Grid>
</Window>
