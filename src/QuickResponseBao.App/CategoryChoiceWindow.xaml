<Window x:Class="QuickResponseBao.App.CategoryChoiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ChooseCategory}" Width="440" Height="180" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
