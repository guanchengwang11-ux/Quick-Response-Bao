<ui:FluentWindow x:Class="QuickResponseBao.App.CategoryDeleteWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource DeleteCategoryTitle}" Width="520" Height="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None" ExtendsContentIntoTitleBar="False" Background="{DynamicResource QrbBackgroundBrush}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource QrbWarningSurfaceBrush}"><ui:SymbolIcon Symbol="Warning24" Style="{DynamicResource QrbIcon20Style}" Foreground="{DynamicResource QrbWarningBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="{DynamicResource DeleteCategoryTitle}" Style="{DynamicResource QrbSectionTitleTextStyle}"/><TextBlock x:Name="CategoryNameText" Style="{DynamicResource QrbBodyTextStyle}" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource QrbBodyTextStyle}" Margin="0,20,0,12"/>
    <StackPanel x:Name="MovePanel" Grid.Row="2"><TextBlock Text="{DynamicResource MoveResponsesTo}" Style="{DynamicResource QrbBodyStrongTextStyle}" Margin="0,0,0,7"/><ComboBox x:Name="DestinationBox"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Cancel}" Style="{DynamicResource QrbGhostButtonStyle}" IsCancel="True"/><Button Content="{DynamicResource MoveAndDelete}" Style="{DynamicResource QrbDangerButtonStyle}" Click="Confirm_Click" IsDefault="True"/></StackPanel>
  </Grid>
</ui:FluentWindow>
