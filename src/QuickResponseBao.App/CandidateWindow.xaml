<Window x:Class="QuickResponseBao.App.CandidateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="600" MaxHeight="520" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" PreviewMouseWheel="CandidateWindow_PreviewMouseWheel">
  <Border Background="{DynamicResource QrbSurfaceBrush}" BorderBrush="{DynamicResource QrbBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource QrbRadius12}" Padding="6">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="10,6,10,8"><TextBlock Text="{DynamicResource Suggestions}" Style="{DynamicResource QrbCaptionTextStyle}"/><TextBlock x:Name="ResultCount" DockPanel.Dock="Right" Style="{DynamicResource QrbCaptionTextStyle}"/></DockPanel>
      <ScrollViewer x:Name="Scroller" Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" IsTabStop="False" Padding="2">
        <StackPanel x:Name="ItemsPanel" Background="Transparent"/>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource QrbBorderBrush}" BorderThickness="0,1,0,0" Margin="6,6,6,0" Padding="4,7,4,2"><TextBlock Text="{DynamicResource CandidateKeyboardHint}" Style="{DynamicResource QrbCaptionTextStyle}" HorizontalAlignment="Center"/></Border>
    </Grid>
  </Border>
</Window>
