<Window x:Class="QuickResponseBao.App.CandidateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" MaxHeight="520" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" PreviewMouseWheel="CandidateWindow_PreviewMouseWheel">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
    <ScrollViewer x:Name="Scroller" MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Focusable="False" IsTabStop="False" Padding="2">
      <StackPanel x:Name="ItemsPanel" Background="Transparent"/>
    </ScrollViewer>
  </Border>
</Window>
